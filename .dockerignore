# Dependências instaladas no host.
# A aplicação vive em src/, então o padrão precisa cobrir qualquer profundidade.
**/node_modules

# Controle de versão e metadados de agente
.git
.gitignore
.claude
.agents
.codex
.opencode
.mcp.json
skills-lock.json

# Segredos e configuração local
.env
.env.*
!.env.example

# Os próprios artefatos Docker
Dockerfile
.dockerignore
docker-compose.yml
compose.yaml

# Artefatos de infraestrutura — não fazem parte da imagem da aplicação
k8s
kind
terraform
**/*.tfstate
**/*.tfstate.*
**/.terraform

# Logs e caches
**/npm-debug.log*
**/yarn-error.log*
**/.npm

# Editor / SO
.vscode
.idea
**/.DS_Store
*.Identifier

# Documentação e utilitários que não vão para a imagem
